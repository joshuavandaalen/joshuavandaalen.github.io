{
  "name": "ddd-melbourne-retro",
  "version": "1.0.0",
  "description": "DDD Melbourne - 90s Geocities Style Edition",
  "main": "server.js",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:kit": "npm run build --workspace packages/retro-ui",
    "build:docs": "npm run build --workspace apps/docs",
    "build:quiz": "npm run build --workspace apps/quiz",
    "build:storybook": "npm run build-storybook --workspace packages/retro-ui",
    "build:all": "npm run build:kit && npm run build:docs && npm run build:quiz",
    "build:pages": "npm run build:all && npm run build:storybook && node scripts/build-pages.mjs",
    "api:generate": "node scripts/extract-api.mjs",
    "api:check": "node scripts/extract-api.mjs --check",
    "typecheck": "npm run typecheck --workspace packages/retro-ui && npm run typecheck --workspace apps/quiz && npm run typecheck --workspace apps/docs",
    "test": "npm run test --workspace packages/retro-ui && npm run test --workspace apps/quiz",
    "serve:dist": "node scripts/serve-static.mjs dist 4173",
    "e2e": "node scripts/e2e/run.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "keywords": ["ddd", "melbourne", "conference", "90s", "retro", "geocities"],
  "author": "DDD Melbourne",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
